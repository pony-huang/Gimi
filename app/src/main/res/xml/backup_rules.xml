<?xml version="1.0" encoding="utf-8"?><!--
   API ≤30 全量备份规则（API 31+ 走 data_extraction_rules.xml）。
   附件字节不进系统自动备份：工作区与遗留按会话归档目录由用户自管，体量不受
   25MB 自动备份配额约束，也不应默认上传云端。
-->
<full-backup-content>
    <exclude domain="file" path="workspace" />
    <exclude domain="file" path="conversation/attachments" />
</full-backup-content>
