<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Gimi Spotify Plugin"
        android:icon="@drawable/ic_spotify">

        <!-- 声明实现类全名，值须与 PluginApi.CLASS_META_DATA_KEY 一致 -->
        <!-- 加载插件代码前校验，版本由构建约定自动固化进 APK。 -->
        <meta-data
            android:name="github.ponyhuang.gimi.plugin.API_VERSION"
            android:value="${pluginApiVersion}" />
        <meta-data
            android:name="github.ponyhuang.gimi.plugin.ADK_VERSION"
            android:value="${pluginAdkVersion}" />

        <meta-data
            android:name="github.ponyhuang.gimi.plugin.CLASS"
            android:value="github.ponyhuang.gimi.plugin.spotify.SpotifyPlugin" />

        <!-- 无功能发现标记：宿主通过 queryIntentServices 发现本插件。 -->
        <service
            android:name="github.ponyhuang.gimi.plugin.spotify.DiscoveryService"
            android:exported="true">
            <intent-filter>
                <action android:name="github.ponyhuang.gimi.plugin.DISCOVERY" />
            </intent-filter>
        </service>
    </application>

</manifest>
