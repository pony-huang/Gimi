<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MCP servers are explicitly user-configured endpoints; the app's domain layer
         already accepts http:// URLs (see McpUseCases.kt). This permits cleartext
         so those endpoints can be reached on Android 9+ where it is disabled by
         default. HTTPS-only endpoints continue to use TLS normally. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
